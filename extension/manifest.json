{
    "manifest_version": 3,
    "name": "Block Bord AI",
    "version": "2.5.0",
    "author": "Block Bord AI Team",
    "description": "Real-time AI Shield and telemetry-driven phishing protection by Block Bord AI.",
    "permissions": [
        "contextMenus",
        "storage",
        "tabs",
        "activeTab",
        "notifications",
        "alarms"
    ],
    "host_permissions": [
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*",
        "https://block-bord-ai-pro.onrender.com/*",
        "*://*/*"
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "options_ui": {
        "page": "options/options.html",
        "open_in_tab": true
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "warning/warning.html",
                "warning/warning.css"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}