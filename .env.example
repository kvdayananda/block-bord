# ═══════════════════════════════════════════════════════════════
# Block Bord AI — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════
# 1. Copy this file: cp .env.example .env
# 2. Fill in ALL values marked [REQUIRED]
# 3. NEVER commit the .env file to git (it's in .gitignore)
# ═══════════════════════════════════════════════════════════════


# ───────────────────────────────────────
# CORE (REQUIRED)
# ───────────────────────────────────────

# Application environment: "development" or "production"
ENV=development

# Session secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production (app will crash with a weak/default secret when ENV=production)
SESSION_SECRET=dev_only_change_me_in_production

# Public URL of the backend (used in CSP headers + extension config)
# Local dev: http://127.0.0.1:8000
# Production: https://your-app-name.onrender.com
BACKEND_URL=http://127.0.0.1:8000

# CORS allowed origins regex (restrict in production to your real frontend domain)
# Dev default allows localhost. In production: r"https://your-app\.onrender\.com"
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?


# ───────────────────────────────────────
# DATABASE (REQUIRED in production)
# ───────────────────────────────────────

# Default: SQLite (dev only). Switch to Neon PostgreSQL for production:
# Get from: https://neon.tech → Your Project → Connection Details
# Format: postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./blockbord.db


# ───────────────────────────────────────
# GOOGLE SAFE BROWSING (REQUIRED for ML layer 1)
# ───────────────────────────────────────

# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: "Safe Browsing API" or "Web Risk API"
# Free: 10,000 requests/day
GOOGLE_SAFE_BROWSING_KEY=


# ───────────────────────────────────────
# ML MODEL (Set path after training)
# ───────────────────────────────────────

# Path to the PhiUSIIL training dataset CSV
# Download from: https://archive.ics.uci.edu/dataset/967/phiusiil+phishing+url+dataset
PHIUSIIL_DATASET_PATH=./ml_data/PhiUSIIL_Phishing_URL_Dataset.csv

# Path to the trained XGBoost model (generated by ml/train_model.py)
XGBOOST_MODEL_PATH=./ml/models/xgboost_phishing_v1.joblib


# ───────────────────────────────────────
# PAYMENTS — RAZORPAY (OPTIONAL)
# ───────────────────────────────────────

# Get from: https://dashboard.razorpay.com → Settings → API Keys
# Leave empty to use test/simulation mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Get from: https://dashboard.razorpay.com → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=

# Set to "false" to use live Razorpay payments (WARNING: real money!)
PAYMENT_TEST_MODE=true


# ───────────────────────────────────────
# AI CHATBOT — GEMINI (OPTIONAL)
# ───────────────────────────────────────

# Get from: https://aistudio.google.com/app/apikey
# Leave empty to use the built-in rule-based chatbot fallback
GEMINI_API_KEY=


# ───────────────────────────────────────
# LEAK CHECKER — HAVE I BEEN PWNED (OPTIONAL)
# ───────────────────────────────────────

# Get from: https://haveibeenpwned.com/API/Key ($3.50/month)
# Leave empty to use the deterministic simulation fallback
HIBP_API_KEY=


# ───────────────────────────────────────
# EMAIL ALERTS — SMTP (OPTIONAL)
# ───────────────────────────────────────

# Configure for sending high-risk email alerts to users
# Example using Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# Leave empty to use console logging fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


# ───────────────────────────────────────
# ERROR MONITORING — SENTRY (OPTIONAL)
# ───────────────────────────────────────

# Get from: https://sentry.io (free tier available)
SENTRY_DSN=
