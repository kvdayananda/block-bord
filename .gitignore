##################################################################
# Block Bord AI — .gitignore
# Laravel 13 + Python ML Microservice + Chrome Extension
##################################################################

# ── SECRETS & ENVIRONMENT ──────────────────────────────────────
.env
.env.local
.env.production
.env.staging
.env.testing

# ── LARAVEL / PHP ──────────────────────────────────────────────
/vendor/
/bootstrap/cache/*.php
/public/hot
/public/storage
/storage/*.key
/storage/app/public/
/storage/debugbar/
/storage/framework/cache/
/storage/framework/sessions/
/storage/framework/testing/
/storage/framework/views/
/storage/logs/
*.log

# Composer binary (never commit)
composer.phar

# Laravel temp / debug files
debug_boot.php
.phpunit.result.cache
bootstrap/cache/config.php
bootstrap/cache/packages.php
bootstrap/cache/routes-v7.php
bootstrap/cache/services.php

# ── PYTHON / ML ────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
dist/
build/
*.so
venv/
.venv/
env/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
sitecustomize.py

# ML model artifacts (generated by train_model.py — do not commit binaries)
backend/ml/models/*.pkl
backend/ml/models/*.joblib
backend/ml/models/*.h5
backend/ml/models/*.bin
backend/ml/models/*.json
backend/ml/scaler.pkl
backend/ml/label_encoder.pkl
backend/ml/trained_model.pkl

# Large ML datasets
ml_data/*.csv
ml_data/*.parquet
ml_data/*.feather

# Old FastAPI / SQLite leftovers
backend/__pycache__/
backend/alembic/
backend/alembic.ini
backend/blockbord.db
backend/tests/
scripts/__pycache__/

# ── DATABASES ──────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── NODE / FRONTEND BUILD ─────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/public/js/compiled/
/public/css/compiled/
/public/mix-manifest.json

# ── IDE & OS ──────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db
desktop.ini

# ── TEMP / SCRATCH FILES ──────────────────────────────────────
check_pages.py
cleanup_duplicates.py
convert_to_pdf.py
detect_duplicates.py
test_results.txt
test_results_ascii.txt
implementation_plan.md
project_analysis.md
*.tmp
*.bak
*.swp
*.swo