{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "blockbord/cyber-shield",
    "type": "project",
    "description": "Block Bord AI - Cyber Intelligence SaaS Platform in Laravel",
    "keywords": ["laravel", "framework", "cybersecurity"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "laravel/framework": "9.52.22",
        "laravel/tinker": "^2.8",
        "symfony/console": "~6.0.19",
        "symfony/finder": "~6.0.0",
        "symfony/error-handler": "~6.0.0",
        "symfony/event-dispatcher": "~6.0.0",
        "symfony/http-foundation": "~6.0.0",
        "symfony/http-kernel": "~6.0.0",
        "symfony/mailer": "~6.0.0",
        "symfony/mime": "~6.0.0",
        "symfony/process": "~6.0.0",
        "symfony/routing": "~6.0.0",
        "symfony/string": "~6.0.0",
        "symfony/translation": "~6.0.0",
        "symfony/uid": "~6.0.0",
        "symfony/var-dumper": "~6.0.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.20",
        "mockery/mockery": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.0.30"
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
